rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global rules for collections
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /packingLists/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Explicit rule for collectionGroup queries on 'palletizations' at any depth
    match /{path=**}/palletizations/{pallet} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Explicit allow for public contact form submissions
    match /messages/{messageId} {
      allow create: if true; 
      allow get, list, delete: if request.auth != null;
    }
  }
}
